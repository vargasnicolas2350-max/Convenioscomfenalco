MAIL_DAYANA=dayana@example.com
MAIL_PRUEBA=your-test-email@example.com
MAIL_JURIDICA=juridica@example.com
MAIL_PRUEBA_JURIDICA=your-test-email@example.com
MODO_PRUEBA=true# Copia este archivo como ".env" y completa los valores. NUNCA subas ".env" a Git.

PORT=3000

# --- Correo (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación" (no la clave normal)
# Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
MAIL_FROM="Portal de Convenios <tu_correo@gmail.com>"

# --- Destinatarios ---
MAIL_DAYANA=dayana.vasquez@comfenalcoantioquia.com
MAIL_PRUEBA=vargasnicolas2350@gmail.com

# --- Envío a Jurídica (Paso 2) ---
# Destinos distintos a los de arriba. Puedes poner varios separados por coma.
# En producción se usa el correo escrito en el formulario; MAIL_JURIDICA es el respaldo si viene vacío.
MAIL_JURIDICA=juridica@comfenalcoantioquia.com
# En modo prueba el correo de Jurídica llega SOLO aquí (si lo dejas vacío usa MAIL_PRUEBA)
MAIL_PRUEBA_JURIDICA=vargasnicolas2350@gmail.com

# true  = los correos llegan a MAIL_PRUEBA / MAIL_PRUEBA_JURIDICA (asunto con [PRUEBA])
# false = los correos llegan a MAIL_DAYANA / a Jurídica
MODO_PRUEBA=true